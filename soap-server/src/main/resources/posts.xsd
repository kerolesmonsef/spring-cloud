<?xml version="1.0" encoding="UTF-8"?>
<!--
  What goes in this file (contract only, no logic):
  - Shared domain complexType (e.g. "post") = the DTO shape exposed over wire. Mirrors what PostXml (wsdl mapper class) carries, NOT the JPA entity.
  - Per CRUD op: 1 request element + 1 response element (getXRequest/Response, createXRequest/Response, etc). These become the generated Request/Response Java classes (Endpoint's @RequestPayload/@ResponsePayload types).
  - Validation constraints (xs:pattern, minLength, enumeration) belong here too, not in Java.
  Does NOT belong here: JPA entity (Post.java/model), repository, service, endpoint routing (@PayloadRoot), WSDL beans (WebServiceConfig). Those are separate Java layers that map to/from these XSD types.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://keroles.com/soapserver/posts" targetNamespace="http://keroles.com/soapserver/posts" elementFormDefault="qualified">

    <xs:element name="post" type="tns:post"/>
    <xs:complexType name="post">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="createdAt" type="xs:dateTime"/>
            <xs:element name="userId" type="xs:long"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="getPostRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="getPostResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="tns:post" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="listPostsRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="listPostsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="tns:post" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="createPostRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="title" type="xs:string"/>
                <xs:element name="description" type="xs:string"/>
                <xs:element name="userId" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="createPostResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="tns:post"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="updatePostRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
                <xs:element name="title" type="xs:string"/>
                <xs:element name="description" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="updatePostResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="deletePostRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="deletePostResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="success" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
